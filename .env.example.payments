# ==================== PAYMENT PROVIDERS CONFIGURATION ====================
# This file contains all environment variables needed for Stripe and Yookassa
# Copy these to your apps/api/.env file and fill in the actual values

# ==================== STRIPE CONFIGURATION ====================
# Stripe is used for international payments (Europe, USA, Ukraine, etc.)
# Get your keys from: https://dashboard.stripe.com/test/apikeys

# Stripe API Keys
STRIPE_SECRET_KEY=sk_test_51...  # Secret key from Stripe Dashboard → Developers → API keys
STRIPE_WEBHOOK_SECRET=whsec_...  # Webhook secret from Stripe Dashboard → Developers → Webhooks

# ==================== STRIPE PRICE IDs ====================
# Each plan has 6 prices: 3 currencies (RUB, USD, EUR) × 2 types (regular, early bird)
# Get these IDs after creating Products in Stripe Dashboard → Products
# Total: 3 plans × 6 prices = 18 Price IDs

# --- LITE Plan Price IDs ---
# Product: ProRab LITE
# Description: Базовый тариф для небольших проектов
# Limits: 1 project, 1 member, 500MB storage

STRIPE_PRICE_LITE_RUB_REGULAR=price_...      # 490 RUB/month
STRIPE_PRICE_LITE_RUB_EARLYBIRD=price_...    # 290 RUB/month (early bird)
STRIPE_PRICE_LITE_USD_REGULAR=price_...      # $7 USD/month
STRIPE_PRICE_LITE_USD_EARLYBIRD=price_...    # $4 USD/month (early bird)
STRIPE_PRICE_LITE_EUR_REGULAR=price_...      # €7 EUR/month
STRIPE_PRICE_LITE_EUR_EARLYBIRD=price_...    # €4 EUR/month (early bird)

# --- FOREMAN Plan Price IDs ---
# Product: ProRab FOREMAN ⭐ (Most Popular)
# Description: Оптимальный тариф для бригадиров
# Limits: 4 projects, 3 members, 2GB storage

STRIPE_PRICE_FOREMAN_RUB_REGULAR=price_...   # 990 RUB/month
STRIPE_PRICE_FOREMAN_RUB_EARLYBIRD=price_... # 690 RUB/month (early bird)
STRIPE_PRICE_FOREMAN_USD_REGULAR=price_...   # $15 USD/month
STRIPE_PRICE_FOREMAN_USD_EARLYBIRD=price_... # $10 USD/month (early bird)
STRIPE_PRICE_FOREMAN_EUR_REGULAR=price_...   # €15 EUR/month
STRIPE_PRICE_FOREMAN_EUR_EARLYBIRD=price_... # €10 EUR/month (early bird)

# --- BRIGADE Plan Price IDs ---
# Product: ProRab BRIGADE
# Description: Профессиональный тариф для крупных бригад
# Limits: Unlimited projects, 10 members, 10GB storage

STRIPE_PRICE_BRIGADE_RUB_REGULAR=price_...   # 1990 RUB/month
STRIPE_PRICE_BRIGADE_RUB_EARLYBIRD=price_... # 1490 RUB/month (early bird)
STRIPE_PRICE_BRIGADE_USD_REGULAR=price_...   # $25 USD/month
STRIPE_PRICE_BRIGADE_USD_EARLYBIRD=price_... # $20 USD/month (early bird)
STRIPE_PRICE_BRIGADE_EUR_REGULAR=price_...   # €25 EUR/month
STRIPE_PRICE_BRIGADE_EUR_EARLYBIRD=price_... # €20 EUR/month (early bird)

# ==================== YOOKASSA CONFIGURATION ====================
# Yookassa (ЮKassa) is used for Russian payments (Russia, Belarus, Kazakhstan, etc.)
# Get your keys from: https://yookassa.ru/my/merchant

# Yookassa API Keys
YOOKASSA_SHOP_ID=123456                      # Shop ID from Yookassa Dashboard → Settings
YOOKASSA_SECRET_KEY=test_...                 # Secret key from Yookassa Dashboard → Settings → API keys
YOOKASSA_WEBHOOK_SECRET=...                  # Webhook secret (optional, for webhook signature verification)

# ==================== YOOKASSA PRICE IDs ====================
# Note: Yookassa doesn't use Price IDs like Stripe
# Instead, we create payments with amount directly from our database
# These variables are for reference only - NOT required in code

# LITE Plan Prices (for reference)
# YOOKASSA_PRICE_LITE_RUB_REGULAR=490        # 490 RUB/month
# YOOKASSA_PRICE_LITE_RUB_EARLYBIRD=290      # 290 RUB/month (early bird)

# FOREMAN Plan Prices (for reference)
# YOOKASSA_PRICE_FOREMAN_RUB_REGULAR=990     # 990 RUB/month
# YOOKASSA_PRICE_FOREMAN_RUB_EARLYBIRD=690   # 690 RUB/month (early bird)

# BRIGADE Plan Prices (for reference)
# YOOKASSA_PRICE_BRIGADE_RUB_REGULAR=1990    # 1990 RUB/month
# YOOKASSA_PRICE_BRIGADE_RUB_EARLYBIRD=1490  # 1490 RUB/month (early bird)

# ==================== NOTES ====================
# 1. Stripe vs Yookassa:
#    - Stripe: Used for international payments (USD, EUR, and some RUB)
#    - Yookassa: Used for Russian market (RUB only)
#
# 2. Auto-selection logic:
#    - Russia/Belarus/Kazakhstan → Yookassa (Primary)
#    - Europe/USA/Ukraine → Stripe (Secondary)
#    - Based on user's IP geolocation
#
# 3. Test Mode vs Production:
#    - Test keys start with: sk_test_, test_
#    - Live keys start with: sk_live_, live_
#    - Always use test keys in development!
#
# 4. Security:
#    - NEVER commit .env file to Git!
#    - Keep secret keys confidential
#    - Use different keys for test/production
#
# 5. Mock Mode (Development):
#    - If no credentials provided → system uses mock payments
#    - Allows testing UI without real payment gateways
#    - Disabled in production automatically

# ==================== QUICK SETUP GUIDE ====================
#
# STRIPE:
# 1. Go to https://stripe.com and sign up
# 2. Dashboard → Developers → API keys → Copy Secret Key
# 3. Dashboard → Products → Create 3 products (LITE, FOREMAN, BRIGADE)
# 4. For each product, create 6 prices (RUB/USD/EUR × regular/earlybird)
# 5. Copy all 18 Price IDs and paste above
# 6. Dashboard → Developers → Webhooks → Add endpoint
# 7. Copy Webhook Secret and paste above
#
# YOOKASSA:
# 1. Go to https://yookassa.ru and register
# 2. Complete merchant verification (required for Russia)
# 3. Dashboard → Settings → Copy Shop ID
# 4. Dashboard → Settings → API keys → Generate secret key
# 5. Copy Shop ID and Secret Key and paste above
# 6. (Optional) Dashboard → Webhooks → Set webhook URL and copy secret
#
# For detailed instructions, see:
# - STRIPE_SETUP_GUIDE.md
# - YOOKASSA_SETUP_GUIDE.md (to be created)

# ==================== VERIFICATION ====================
# After setup, verify your configuration:
#
# 1. Start API server:
#    cd apps/api && pnpm dev
#
# 2. Check logs for:
#    ✅ "Stripe provider initialized successfully from environment variables"
#    ✅ "Yookassa provider initialized successfully from environment variables"
#
# 3. Test payment flow:
#    - Open http://localhost:3000
#    - Go to Settings → Subscriptions
#    - Click "Выбрать план"
#    - Should redirect to payment page (Stripe or Yookassa based on your location)
#
# 4. Use test cards:
#    Stripe: 4242 4242 4242 4242
#    Yookassa: Use test cards from Yookassa documentation
