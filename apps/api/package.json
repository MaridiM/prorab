  "scripts": {
    "dev": "pnpm start:dev",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prisma:generate": "prisma generate --schema ./prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema ./prisma/schema.prisma",
    "prisma:studio": "prisma studio --port 5555",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:plans": "tsx prisma/seed-plans.ts",
    "prisma:seed:providers": "tsx prisma/seed-payment-providers.ts",
    "prisma:seed:faq": "tsx prisma/seed-faq.ts",
    "prisma:seed:settings": "tsx prisma/seed-storage-settings.ts",
    "prisma:seed:demo-payments": "tsx scripts/seed-demo-payment-history.ts",
    "db:reset": "tsx scripts/reset-database.ts",
    "db:reset:seed": "pnpm db:reset && pnpm prisma:seed:plans && pnpm prisma:seed:providers && pnpm prisma:seed && pnpm prisma:seed:faq && pnpm prisma:seed:settings && pnpm prisma:seed:demo-payments",
    "stripe:create-products": "tsx scripts/create-stripe-products.ts",
    "yookassa:create-config": "tsx scripts/create-yookassa-config.ts",
    "db:seed": "pnpm prisma:seed",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "tunnel": "ngrok http --url=first-cosmic-mongrel.ngrok-free.app 8080"
  },
