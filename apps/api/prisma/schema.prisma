generator client {
  provider      = "prisma-client"
  output        = "./generated"
  binaryTargets = ["native", "debian-openssl-3.0.x", "windows"]
}

datasource db {
  provider = "postgresql"
}

// ==================== AUTH ====================

model User {
  id                     String    @id @default(uuid())
  email                  String    @unique
  emailNormalized        String    @unique @map("email_normalized")
  emailVerified          Boolean   @default(false) @map("email_verified")
  passwordHash           String?   @map("password_hash") // Nullable для OAuth users
  fullName               String    @map("full_name")
  phone                  String?
  avatarUrl              String?   @map("avatar_url")
  hasCompletedOnboarding Boolean   @default(false) @map("has_completed_onboarding")
  onboardingCompletedAt  DateTime? @map("onboarding_completed_at")
  currentTeamId          String?   @map("current_team_id")

  // OAuth fields
  oauthProvider    String? @map("oauth_provider") // "telegram", "google", etc.
  oauthProviderId  String? @map("oauth_provider_id") // Provider's user ID
  telegramChatId   String? @unique @map("telegram_chat_id")
  telegramUsername String? @map("telegram_username")
  telegramPhotoUrl String? @map("telegram_photo_url")

  // Two-Factor Authentication
  twoFactorEnabled     Boolean  @default(false) @map("two_factor_enabled")
  twoFactorSecret      String?  @map("two_factor_secret") // Encrypted TOTP secret
  twoFactorBackupCodes String[] @default([]) @map("two_factor_backup_codes") // Hashed backup codes

  // Storage Provider Settings
  storagePreference   StorageProviderType? @map("storage_preference")
  storageMigratedFrom StorageProviderType? @map("storage_migrated_from")
  storageMigratedAt   DateTime?            @map("storage_migrated_at")

  // Business Role - Global role constraint (FOREMAN or WORKER)
  businessRole           BusinessRole? @map("business_role")
  businessRoleAssignedAt DateTime?     @map("business_role_assigned_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  verificationTokens   VerificationToken[]
  passwordResetTokens  PasswordResetToken[]
  notificationSettings NotificationSettings?
  ownedTeams           Team[]                    @relation("TeamOwner")
  teamMemberships      TeamMember[]
  currentTeam          Team?                     @relation("CurrentTeam", fields: [currentTeamId], references: [id], onDelete: SetNull)
  createdTasks         Task[]                    @relation("CreatedTasks")
  supportTickets       SupportTicket[]
  salaryChanges        TeamMemberSalaryHistory[] @relation("SalaryChangedBy")
  adminRole            AdminRole?
  adminActionLogs      AdminActionLog[]          @relation("AdminActionLogs")
  createdTemplates     TeamTemplate[]            @relation("TeamTemplateCreator")

  @@index([currentTeamId])
  @@index([oauthProvider, oauthProviderId])
  @@index([telegramChatId])
  @@map("users")
}

model NotificationSettings {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  // App
  appPush  Boolean @default(true) @map("app_push")
  appEmail Boolean @default(true) @map("app_email")
  appSms   Boolean @default(false) @map("app_sms")

  // Telegram
  telegramEnabled       Boolean @default(true) @map("telegram_enabled")
  telegramSalaryChanges Boolean @default(true) @map("telegram_salary_changes")
  telegramPayouts       Boolean @default(true) @map("telegram_payouts")

  // Marketing
  marketingPush  Boolean @default(false) @map("marketing_push")
  marketingEmail Boolean @default(true) @map("marketing_email")

  // Event-specific notifications (detailed control)
  notifyProjectCreated       Boolean @default(true) @map("notify_project_created")
  notifyProjectCompleted     Boolean @default(true) @map("notify_project_completed")
  notifyExpenseAdded         Boolean @default(true) @map("notify_expense_added")
  notifyPayoutCalculated     Boolean @default(true) @map("notify_payout_calculated")
  notifyPayoutPaid           Boolean @default(true) @map("notify_payout_paid")
  notifyMemberInvited        Boolean @default(true) @map("notify_member_invited")
  notifyMemberJoined         Boolean @default(true) @map("notify_member_joined")
  notifyMemberRemoved        Boolean @default(true) @map("notify_member_removed")
  notifyTaskAssigned         Boolean @default(true) @map("notify_task_assigned")
  notifyTaskCompleted        Boolean @default(true) @map("notify_task_completed")
  notifyPhotoReportCreated   Boolean @default(true) @map("notify_photo_report_created")
  notifySubscriptionExpiring Boolean @default(true) @map("notify_subscription_expiring")

  // Notification frequency
  emailFrequency NotificationFrequency @default(INSTANT) @map("email_frequency")
  pushFrequency  NotificationFrequency @default(INSTANT) @map("push_frequency")

  // Quiet hours (Don't disturb period)
  quietHoursEnabled Boolean @default(false) @map("quiet_hours_enabled")
  quietHoursStart   String? @map("quiet_hours_start") // Format: "HH:mm" (e.g., "22:00")
  quietHoursEnd     String? @map("quiet_hours_end") // Format: "HH:mm" (e.g., "08:00")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

enum NotificationFrequency {
  INSTANT // Send immediately
  DAILY // Digest once per day
  WEEKLY // Digest once per week
}

model VerificationToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model TelegramAuthToken {
  id        String   @id @default(uuid())
  token            String   @unique
  chatId           String?  @map("chat_id")
  telegramFirstName String? @map("telegram_first_name")
  telegramLastName  String? @map("telegram_last_name")
  telegramUsername  String? @map("telegram_username")
  telegramPhotoUrl  String? @map("telegram_photo_url")
  used      Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([token])
  @@index([expiresAt])
  @@map("telegram_auth_tokens")
}

// ==================== BUSINESS ====================

model Team {
  id               String   @id @default(uuid())
  name             String
  logoType         LogoType @default(GENERATED) @map("logo_type")
  logoUrl          String?  @map("logo_url")
  iconId           String?  @map("icon_id")
  colorId          String?  @map("color_id")
  ownerId          String   @map("owner_id")
  storageUsedBytes BigInt   @default(0) @map("storage_used_bytes")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  owner           User               @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members         TeamMember[]
  projects        Project[]
  inviteCodes     InviteCode[]
  currentForUsers User[]             @relation("CurrentTeam")
  subscription        Subscription?
  customRoles         CustomRole[]
  announcements       TeamAnnouncement[]
  auditLogs           TeamAuditLog[]
  retentionPolicies   DataRetentionPolicy[]

  @@index([ownerId])
  @@map("teams")
}

enum LogoType {
  UPLOADED
  GENERATED
  DEFAULT
}

enum StorageProviderType {
  LOCAL
  CLOUDINARY
  R2
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  COMPLETED
}

model ProjectPayout {
  id               String    @id @default(uuid())
  projectId        String    @map("project_id")
  memberId         String    @map("member_id")
  calculatedAmount Decimal   @map("calculated_amount") @db.Decimal(12, 2)
  actualAmount     Decimal?  @map("actual_amount") @db.Decimal(12, 2)
  status           String    @default("pending") // "pending", "paid"
  paidAt           DateTime? @map("paid_at")
  notes            String?   @db.Text

  // Payment method fields
  paymentMethod String? @default("cash") @map("payment_method") // "cash", "card", "transfer", "sbp"
  receiptUrl    String? @map("receipt_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member  TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([memberId])
  @@index([projectId, status])
  @@map("project_payouts")
}

model WorkLog {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  memberId    String   @map("member_id")
  date        DateTime // Date of work
  hours       Decimal  @db.Decimal(5, 2) // Hours worked (max 999.99)
  description String?  @db.Text

  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member  TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([memberId])
  @@index([date])
  @@index([projectId, memberId, date])
  @@map("work_logs")
}

// ==================== CUSTOM TEAM ROLES ====================

model CustomRole {
  id          String  @id @default(uuid())
  teamId      String  @map("team_id")
  name        String  @db.VarChar(100) // "Старший прораб", "Бухгалтер"
  description String? @db.Text
  color       String? @db.VarChar(20) // Hex color for UI display

  // Permissions (JSON array of permission keys)
  permissions String[] @default([])

  // Hierarchy
  parentRoleId String? @map("parent_role_id") // Inherit permissions from parent
  level        Int     @default(0) // Role hierarchy level (0 = base, higher = more privileged)

  // Metadata
  isActive   Boolean @default(true) @map("is_active")
  isBuiltIn  Boolean @default(false) @map("is_built_in") // System-defined roles (cannot be deleted)
  sortOrder  Int     @default(0) @map("sort_order")
  createdBy  String  @map("created_by")
  modifiedBy String? @map("modified_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  parentRole   CustomRole?  @relation("RoleHierarchy", fields: [parentRoleId], references: [id], onDelete: SetNull)
  childRoles   CustomRole[] @relation("RoleHierarchy")
  teamMembers  TeamMember[]
  assignmentHistory RoleAssignmentHistory[]

  @@unique([teamId, name])
  @@index([teamId])
  @@index([parentRoleId])
  @@index([teamId, isActive])
  @@index([teamId, sortOrder])
  @@map("custom_roles")
}

model RoleAssignmentHistory {
  id           String   @id @default(uuid())
  memberId     String   @map("member_id")
  teamId       String   @map("team_id")
  previousRole String?  @map("previous_role") // Role name or ID
  newRole      String   @map("new_role") // Role name or ID
  roleId       String?  @map("role_id") // CustomRole ID if applicable
  assignedBy   String   @map("assigned_by") // User ID who made the change
  reason       String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  role CustomRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@index([memberId])
  @@index([teamId])
  @@index([roleId])
  @@index([createdAt])
  @@map("role_assignment_history")
}

model TeamMember {
  id       String   @id @default(uuid())
  teamId   String   @map("team_id")
  userId   String   @map("user_id")
  role     TeamRole @default(MEMBER) // Changed from String to TeamRole enum
  position String?  @db.VarChar(100) // Job position/specialization (e.g., "Прораб", "Электрик", "Маляр")
  joinedAt DateTime @default(now()) @map("joined_at")

  // Custom Role Assignment (optional - overrides default role permissions)
  customRoleId String? @map("custom_role_id")

  // Salary fields
  salaryType   String   @default("none") @map("salary_type") // "fixed", "percentage", "none"
  salaryAmount Decimal? @map("salary_amount") @db.Decimal(12, 2)

  team          Team                      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole    CustomRole?               @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  payouts       ProjectPayout[]
  workLogs      WorkLog[]
  assignedTasks Task[]                    @relation("AssignedTasks")
  salaryHistory TeamMemberSalaryHistory[]

  @@unique([teamId, userId])
  @@index([userId])
  @@index([teamId])
  @@index([teamId, salaryType])
  @@index([teamId, position])
  @@index([customRoleId])
  @@map("team_members")
}

model TeamMemberSalaryHistory {
  id              String   @id @default(uuid())
  memberId        String   @map("member_id")
  previousType    String?  @map("previous_type") // "fixed", "percentage", "none" (null for first entry)
  previousAmount  Decimal? @map("previous_amount") @db.Decimal(12, 2)
  newType         String   @map("new_type") // "fixed", "percentage", "none"
  newAmount       Decimal? @map("new_amount") @db.Decimal(12, 2)
  changedByUserId String   @map("changed_by_user_id")
  reason          String?  @db.Text // Optional reason for change
  createdAt       DateTime @default(now()) @map("created_at")

  member    TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  changedBy User       @relation("SalaryChangedBy", fields: [changedByUserId], references: [id])

  @@index([memberId])
  @@index([memberId, createdAt])
  @@map("team_member_salary_history")
}

model InviteCode {
  id        String    @id @default(uuid())
  teamId    String    @map("team_id")
  code      String    @unique
  expiresAt DateTime  @map("expires_at")
  usedBy    String?   @map("used_by")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([code])
  @@map("invite_codes")
}

model Project {
  id          String  @id @default(uuid())
  teamId      String  @map("team_id")
  name        String
  address     String?
  description String?

  // Финансовые поля
  budget      Decimal? @db.Decimal(12, 2)
  clientPhone String?  @map("client_phone")

  // Даты
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")

  // Метаданные
  photoUrl    String?       @map("photo_url")
  progress    Int           @default(0) // 0-100
  notes       String?       @db.Text
  status      ProjectStatus @default(ACTIVE)
  archivedAt  DateTime?     @map("archived_at")
  completedAt DateTime?     @map("completed_at")

  // Project closure fields
  closedAt    DateTime? @map("closed_at")
  finalProfit Decimal?  @map("final_profit") @db.Decimal(12, 2)

  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  team         Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  expenses     Expense[]
  photoReports PhotoReport[]
  payouts      ProjectPayout[]
  workLogs     WorkLog[]
  tasks        Task[]

  @@index([teamId])
  @@index([teamId, status])
  @@index([status])
  @@index([createdById])
  @@map("projects")
}

model Expense {
  id           String   @id @default(uuid())
  projectId    String   @map("project_id")
  amount       Decimal  @db.Decimal(12, 2)
  category     String
  photos       String[] @default([])
  comment      String?  @db.Text
  paidByClient Boolean  @default(false) @map("paid_by_client")

  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdById])
  @@index([createdAt])
  @@index([projectId, category])
  @@map("expenses")
}

model PhotoReport {
  id            String  @id @default(uuid())
  slug          String  @unique @db.VarChar(10)
  projectId     String  @map("project_id")
  title         String  @db.VarChar(200)
  description   String? @db.Text
  coverPhotoUrl String? @map("cover_photo_url")
  isPublic      Boolean @default(true) @map("is_public")
  viewCount     Int     @default(0) @map("view_count")

  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  publishedAt DateTime? @map("published_at")

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  photos  ReportPhoto[]

  @@index([slug])
  @@index([projectId])
  @@index([createdAt])
  @@index([isPublic])
  @@map("photo_reports")
}

model ReportPhoto {
  id           String  @id @default(uuid())
  reportId     String  @map("report_id")
  photoUrl     String  @map("photo_url")
  thumbnailUrl String? @map("thumbnail_url")
  caption      String? @db.Text
  orderIndex   Int     @default(0) @map("order_index")
  width        Int?
  height       Int?
  fileSize     Int?    @map("file_size")

  createdAt DateTime @default(now()) @map("created_at")

  report PhotoReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, orderIndex])
  @@map("report_photos")
}

// ==================== TASKS ====================

model Task {
  id          String     @id @default(uuid())
  projectId   String     @map("project_id")
  title       String     @db.VarChar(200)
  description String?    @db.Text
  status      TaskStatus @default(TODO)

  // Assignment
  assigneeId String? @map("assignee_id")

  // Priority & Deadline
  priority TaskPriority @default(MEDIUM)
  dueDate  DateTime?    @map("due_date")

  // Ordering (CRITICAL for drag & drop)
  orderIndex Int @map("order_index")

  // Checklist (optional for MVP)
  checklist Json?

  // Metadata
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")

  // Relations
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee  TeamMember? @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User        @relation("CreatedTasks", fields: [createdById], references: [id])

  // Indexes (CRITICAL for performance)
  @@index([projectId, status, orderIndex]) // Main Kanban query
  @@index([assigneeId])
  @@index([dueDate])
  @@index([projectId, status])
  @@map("tasks")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ==================== SUBSCRIPTIONS & PAYMENTS ====================

// Subscription Plan - Database-stored tariff plans (replaces hardcoded plans)
// Note: Model is named "Plan" to avoid conflict with "SubscriptionPlan" enum
model Plan {
  id          String  @id @default(uuid())
  slug        String  @unique @db.VarChar(50) // "lite", "foreman", "brigade"
  name        String  @db.VarChar(100) // "Лайт", "Прораб", "Бригада"
  description String? @db.Text

  // Plan Limits
  maxActiveProjects Int?  // null = unlimited (for BRIGADE plan)
  maxMembers        Int   @map("max_members")
  storageGB         Float @map("storage_gb") // Storage limit in GB

  // Metadata
  isActive    Boolean @default(true) @map("is_active") // Can be purchased
  isPopular   Boolean @default(false) @map("is_popular") // Display "Most Popular" badge
  sortOrder   Int     @default(0) @map("sort_order") // Display order
  isEarlyBird Boolean @default(false) @map("is_early_bird") // Early bird pricing active

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  prices        PlanPrice[]
  features      PlanFeature[]
  subscriptions Subscription[]

  @@index([slug])
  @@index([isActive])
  @@index([sortOrder])
  @@map("subscription_plans")
}

// Plan Price - Multi-currency pricing for each plan
model PlanPrice {
  id       String @id @default(uuid())
  planId   String @map("plan_id")
  currency String @db.VarChar(3) // "RUB", "USD", "EUR"

  price          Decimal @db.Decimal(10, 2) // Regular price
  earlyBirdPrice Decimal @db.Decimal(10, 2) @map("early_bird_price") // Discounted price for early adopters

  billingCycleDays Int @default(30) @map("billing_cycle_days") // 30 for monthly, 365 for yearly

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, currency, billingCycleDays])
  @@index([planId])
  @@index([currency])
  @@map("plan_prices")
}

// Plan Feature - Features included in each plan
model PlanFeature {
  id          String  @id @default(uuid())
  planId      String  @map("plan_id")
  name        String  @db.VarChar(200) // "Базовый функционал", "Расчёты зарплаты"
  description String? @db.Text // Detailed description (optional)
  isIncluded  Boolean @default(true) @map("is_included") // true = included, false = not included
  sortOrder   Int     @default(0) @map("sort_order") // Display order

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([planId, sortOrder])
  @@map("plan_features")
}

// Payment Provider - Configuration for payment gateways (Yookassa, Stripe)
model PaymentProvider {
  id   String              @id @default(uuid())
  type PaymentProviderType @unique
  name String              @db.VarChar(100) // "Yookassa", "Stripe"

  isActive  Boolean @default(false) @map("is_active") // Can be used for payments
  isPrimary Boolean @default(false) @map("is_primary") // Default provider for new payments

  // Configuration stored in SystemSettings (encrypted)
  // Keys: payment.yookassa.shop_id, payment.yookassa.secret_key, etc.

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("payment_providers")
}

enum PaymentProviderType {
  YOOKASSA
  STRIPE
}

model Subscription {
  id                     String             @id @default(uuid())
  teamId                 String             @unique @map("team_id")
  plan                   SubscriptionPlan   // DEPRECATED: Will be replaced by planId
  planId                 String?            @map("plan_id") // NEW: Foreign key to SubscriptionPlan
  status                 SubscriptionStatus @default(TRIALING)
  currentPeriodStart     DateTime           @map("current_period_start")
  currentPeriodEnd       DateTime           @map("current_period_end")
  trialEndsAt            DateTime?          @map("trial_ends_at")
  yookassaSubscriptionId String?            @unique @map("yookassa_subscription_id")
  paymentMethodId        String?            @map("payment_method_id")
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  cancelledAt            DateTime?          @map("cancelled_at")
  isEarlyBird            Boolean            @default(false) @map("is_early_bird")
  currency               String             @default("RUB") @db.VarChar(3) // NEW: Subscription currency
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  team          Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  planRef       Plan?                @relation(fields: [planId], references: [id]) // NEW: Relation to Plan model
  payments      Payment[]

  @@index([teamId])
  @@index([status])
  @@index([plan])
  @@index([planId]) // NEW: Index for planId
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

enum SubscriptionPlan {
  LITE
  FOREMAN
  BRIGADE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model Payment {
  id             String        @id @default(uuid())
  subscriptionId String        @map("subscription_id")
  teamId         String        @map("team_id")
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("RUB") @db.VarChar(3)
  status         PaymentStatus @default(PENDING)

  // Multi-provider support
  providerType      PaymentProviderType @default(YOOKASSA) @map("provider_type") // NEW: Which provider was used
  providerPaymentId String              @unique @map("provider_payment_id") // NEW: Provider's payment ID (Yookassa or Stripe)

  // DEPRECATED fields (kept for backward compatibility)
  yookassaPaymentId String? @unique @map("yookassa_payment_id") // DEPRECATED: Use providerPaymentId instead

  paymentMethod String?  @map("payment_method")
  description   String?  @db.Text
  failureReason String?  @map("failure_reason") @db.Text
  paidAt        DateTime? @map("paid_at")
  refundedAt    DateTime? @map("refunded_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([teamId])
  @@index([status])
  @@index([providerType]) // NEW: Index for provider type
  @@index([createdAt])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  CANCELLED
  FAILED
  REFUNDED
}

// ==================== TELEGRAM SUPPORT ====================

model SupportTicket {
  id             String                @id @default(uuid())
  userId         String                @map("user_id")
  telegramChatId String                @map("telegram_chat_id")
  subject        String?
  status         SupportTicketStatus   @default(OPEN)
  priority       SupportTicketPriority @default(MEDIUM)
  category       String?
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  closedAt       DateTime?             @map("closed_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([userId])
  @@index([telegramChatId])
  @@index([status])
  @@map("support_tickets")
}

model SupportMessage {
  id        String   @id @default(uuid())
  ticketId  String   @map("ticket_id")
  fromUser  Boolean  @default(true) @map("from_user") // true = from user, false = from support
  message   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("support_messages")
}

model FAQEntry {
  id         String   @id @default(uuid())
  question   String
  answer     String   @db.Text
  category   String
  keywords   String[] // Для keyword matching
  views      Int      @default(0)
  helpful    Int      @default(0)
  notHelpful Int      @default(0) @map("not_helpful")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("faq_entries")
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ==================== ADMIN PANEL ====================

model AdminRole {
  id          String        @id @default(uuid())
  userId      String        @unique @map("user_id")
  role        AdminRoleType
  permissions String[]      @default([]) // Array of permission strings
  assignedBy  String?       @map("assigned_by") // Admin who assigned this role
  assignedAt  DateTime      @default(now()) @map("assigned_at")

  // 2FA enforcement for admins
  twoFactorEnforced Boolean @default(true) @map("two_factor_enforced")

  // IP whitelist (optional)
  ipWhitelist String[] @default([]) @map("ip_whitelist")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([role])
  @@map("admin_roles")
}

enum AdminRoleType {
  SUPER_ADMIN // Full system access
  ADMIN // Most admin features
  MODERATOR // Content moderation, user support
  SUPPORT // User support only
}

// Business Role - Global user role constraint
enum BusinessRole {
  FOREMAN // Бригадир - владелец команды, не может присоединяться к другим командам
  WORKER // Работник - член команды, не может создавать команды
}

// Team Role - Contextual role within a specific team
enum TeamRole {
  OWNER // Владелец команды (was 'owner')
  MEMBER // Участник команды (was 'member')
}

model SystemSettings {
  id           String           @id @default(uuid())
  key          String           @unique
  category     SettingCategory
  name         String
  description  String?          @db.Text
  valueType    SettingValueType @map("value_type")
  value        String?          @db.Text
  defaultValue String?          @map("default_value") @db.Text
  isEncrypted  Boolean          @default(false) @map("is_encrypted")
  isRequired   Boolean          @default(false) @map("is_required")

  // Validation
  validationRules Json? @map("validation_rules") // JSON schema for validation

  // Metadata
  updatedBy String?  @map("updated_by") // Admin user ID
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([category])
  @@index([key])
  @@map("system_settings")
}

enum SettingCategory {
  PAYMENT // Yookassa settings
  EMAIL // Brevo settings
  TELEGRAM // Telegram bot settings
  STORAGE // R2 storage settings
  SMS // SMS provider settings (Twilio)
  SOCIAL // Social auth settings (OAuth)
  ANALYTICS // Analytics settings (GA, Metrika, PostHog)
  AI // AI service settings
  SECURITY // Security configurations
  GENERAL // General app settings
}

enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
  ENCRYPTED
}

model AdminActionLog {
  id          String   @id @default(uuid())
  adminUserId String   @map("admin_user_id")
  action      String // Action type (e.g., "UPDATE_SETTING", "DELETE_USER")
  resource    String // Resource affected (e.g., "SystemSettings", "User")
  resourceId  String?  @map("resource_id") // ID of affected resource
  details     Json? // Additional details
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  adminUser User @relation("AdminActionLogs", fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("admin_action_logs")
}

model SystemStatistics {
  id   String   @id @default(uuid())
  date DateTime @unique // Daily statistics

  // User stats
  totalUsers  Int @default(0) @map("total_users")
  activeUsers Int @default(0) @map("active_users")
  newUsers    Int @default(0) @map("new_users")

  // Team stats
  totalTeams  Int @default(0) @map("total_teams")
  activeTeams Int @default(0) @map("active_teams")
  newTeams    Int @default(0) @map("new_teams")

  // Project stats
  totalProjects     Int @default(0) @map("total_projects")
  activeProjects    Int @default(0) @map("active_projects")
  completedProjects Int @default(0) @map("completed_projects")

  // Financial stats
  totalRevenue Decimal @default(0) @map("total_revenue") @db.Decimal(12, 2)
  mrr          Decimal @default(0) @map("mrr") @db.Decimal(12, 2) // Monthly Recurring Revenue

  // Subscription stats
  trialingSubscriptions  Int @default(0) @map("trialing_subscriptions")
  activeSubscriptions    Int @default(0) @map("active_subscriptions")
  cancelledSubscriptions Int @default(0) @map("cancelled_subscriptions")

  // Storage stats
  totalStorageUsed BigInt @default(0) @map("total_storage_used")

  // Support stats
  openTickets   Int @default(0) @map("open_tickets")
  closedTickets Int @default(0) @map("closed_tickets")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([date])
  @@map("system_statistics")
}

// ==================== TEAM COMMUNICATIONS ====================

model TeamAnnouncement {
  id          String   @id @default(uuid())
  teamId      String?  @map("team_id") // null = global announcement
  title       String   @db.VarChar(200)
  content     String   @db.Text
  priority    AnnouncementPriority @default(NORMAL)
  type        AnnouncementType     @default(INFO)
  isPinned    Boolean  @default(false) @map("is_pinned")
  expiresAt   DateTime? @map("expires_at")
  publishedAt DateTime? @map("published_at")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  team      Team?              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  readBy    AnnouncementRead[]

  @@index([teamId])
  @@index([publishedAt])
  @@index([expiresAt])
  @@map("team_announcements")
}

model AnnouncementRead {
  id             String   @id @default(uuid())
  announcementId String   @map("announcement_id")
  userId         String   @map("user_id")
  readAt         DateTime @default(now()) @map("read_at")

  announcement TeamAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
  @@map("announcement_reads")
}

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AnnouncementType {
  INFO
  WARNING
  SUCCESS
  ERROR
  MAINTENANCE
}

// ==================== TEAM OPERATIONS ====================

model TeamTemplate {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  description String?  @db.Text
  settings    Json     // Team settings structure
  roles       Json     // Default custom roles configuration
  projectSetup Json?   // Optional default project structure
  isPublic    Boolean  @default(false) @map("is_public")
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy User @relation("TeamTemplateCreator", fields: [createdById], references: [id])

  @@index([createdById])
  @@index([isPublic])
  @@map("team_templates")
}

model TeamMergeLog {
  id            String   @id @default(uuid())
  sourceTeamId  String   @map("source_team_id")
  targetTeamId  String   @map("target_team_id")
  mergedById    String   @map("merged_by_id")
  membersMoved  Int      @map("members_moved")
  projectsMoved Int      @map("projects_moved")
  dataSnapshot  Json     @map("data_snapshot") // Full snapshot before merge
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([sourceTeamId])
  @@index([targetTeamId])
  @@index([mergedById])
  @@map("team_merge_logs")
}

model TeamCloneLog {
  id             String   @id @default(uuid())
  sourceTeamId   String   @map("source_team_id")
  clonedTeamId   String   @map("cloned_team_id")
  clonedById     String   @map("cloned_by_id")
  clonedSettings Json     @map("cloned_settings") // What was cloned (roles, projects, etc)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([sourceTeamId])
  @@index([clonedTeamId])
  @@index([clonedById])
  @@map("team_clone_logs")
}

// ==================== AUDIT & COMPLIANCE ====================

model TeamAuditLog {
  id         String        @id @default(uuid())
  teamId     String        @map("team_id")
  userId     String?       @map("user_id")
  action     String        @db.VarChar(100)
  category   AuditCategory
  resource   String        @db.VarChar(100)
  resourceId String?       @map("resource_id")
  oldValue   Json?         @map("old_value")
  newValue   Json?         @map("new_value")
  ipAddress  String?       @map("ip_address") @db.VarChar(45)
  userAgent  String?       @map("user_agent") @db.Text
  metadata   Json?
  createdAt  DateTime      @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
  @@index([userId])
  @@index([category])
  @@index([createdAt])
  @@map("team_audit_logs")
}

model DataRetentionPolicy {
  id            String   @id @default(uuid())
  teamId        String?  @map("team_id")
  resourceType  String   @db.VarChar(50)
  retentionDays Int      @map("retention_days")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  team Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, resourceType])
  @@index([teamId])
  @@index([isActive])
  @@map("data_retention_policies")
}

model DataExportRequest {
  id            String         @id @default(uuid())
  teamId        String?        @map("team_id")
  userId        String?        @map("user_id")
  requestedById String         @map("requested_by_id")
  type          DataExportType
  status        ExportStatus   @default(PENDING)
  format        ExportFormat   @default(JSON)
  fileUrl       String?        @map("file_url")
  expiresAt     DateTime?      @map("expires_at")
  completedAt   DateTime?      @map("completed_at")
  errorMessage  String?        @map("error_message") @db.Text
  createdAt     DateTime       @default(now()) @map("created_at")

  @@index([teamId])
  @@index([userId])
  @@index([requestedById])
  @@index([status])
  @@map("data_export_requests")
}

enum AuditCategory {
  MEMBER_MANAGEMENT
  PROJECT_MANAGEMENT
  FINANCIAL
  SETTINGS
  PERMISSIONS
  DATA_ACCESS
  AUTHENTICATION
  INTEGRATIONS
}

enum DataExportType {
  TEAM_DATA
  USER_DATA
  GDPR_FULL
  AUDIT_LOGS
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ExportFormat {
  JSON
  CSV
  PDF
}
